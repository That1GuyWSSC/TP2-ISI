<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VendingMachine.MainPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25"
                WidthRequest="300"
                Grid.Row="0">

                <Entry x:Name="name" Placeholder="NOME"></Entry>
                <Entry x:Name="description" Placeholder ="DESCRIÇÃO"></Entry>
                <HorizontalStackLayout
                    Padding="30,0"
                    Spacing="25"
                    WidthRequest="300">
                    <Button x:Name="cancel" Text="Cancelar" Clicked="cancel_Clicked" Margin="10" HorizontalOptions="Start"/>
                    <Button x:Name="save" Text="Guardar" Clicked="save_Clicked" Margin="10" HorizontalOptions="End"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <VerticalStackLayout
                Padding="30,0"
                Spacing="25"
                WidthRequest = "300"
                Grid.Row="1">
                <Entry x:Name="id" Placeholder="ID"/>
                <Button x:Name="delete" Text="Delete" Clicked="delete_Clicked"/>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout
            Padding="30,0"
            Spacing="25"
            WidthRequest="300"
            Grid.Column="1">
            <Entry x:Name="id_search" Placeholder="ID"></Entry>
            <Entry x:Name="name_search" Placeholder="NOME" IsEnabled="False"></Entry>
            <Entry x:Name="description_search" Placeholder ="DESCRIÇÃO" IsEnabled="False"></Entry>
            <HorizontalStackLayout
                Padding="30,0"
                Spacing="25"
                WidthRequest="300">
                <Button x:Name="cancelSearch" Text="Cancelar" Clicked="searchCancel_Clicked" Margin="10" HorizontalOptions="Start"/>
                <Button x:Name="search" Text="Procurar" Clicked="search_Clicked" Margin="10" HorizontalOptions="End"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>

    </Grid>
        

        

</ContentPage>
